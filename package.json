{
  "name": "closet",
  "description": "A personal wardrobe app with original photos, outfit planning, offline Android support, local sync, and portable backups.",
  "version": "1.2.2",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/local-server.mjs dev",
    "build": "node scripts/local-server.mjs build",
    "start": "node scripts/local-server.mjs start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/test-suite.mjs",
    "mcp": "node scripts/mcp-stdio.mjs",
    "db:generate": "drizzle-kit generate",
    "i18n:extract": "node scripts/i18n-catalog.mjs",
    "mobile:build": "node node_modules/vite/bin/vite.js build --config mobile/vite.config.ts",
    "android:apk": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1",
    "android:sync": "node node_modules/@capacitor/cli/bin/capacitor sync android"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@hookform/resolvers": "^5.7.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@shadcn/react": "^0.3.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "0.45.2",
    "embla-carousel-react": "^8.6.0",
    "fflate": "^0.8.3",
    "input-otp": "^1.4.2",
    "lucide-react": "^1.31.0",
    "next": "16.3.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "19.2.6",
    "react-day-picker": "^10.0.1",
    "react-dom": "19.2.6",
    "react-hook-form": "^7.85.0",
    "react-resizable-panels": "^4.12.2",
    "recharts": "^3.8.0",
    "sharp": "0.35.4",
    "sonner": "^2.0.8",
    "tailwind-merge": "3.6.0",
    "vaul": "^1.1.2",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "drizzle-kit": "0.31.10",
    "esbuild": "0.27.4",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "tailwindcss": "4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9.3",
    "vite": "^7.3.7"
  },
  "type": "module",
  "packageManager": "pnpm@11.25.0"
}
